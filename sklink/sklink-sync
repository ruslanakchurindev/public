#!/usr/bin/env bash
set -euo pipefail

# Reconcile agent skill links from the manifest. See usage() below and README.md.
#
#   user            -> every detected agent skills root
#   project:<repo>  -> <repo>/{.claude,.codex}/skills
#
# Idempotent and prune-safe: it records the links it creates in a state file and
# later prunes only those, never a skill it did not create.
#
# --print-roots / --print-plan are what `sklink doctor` consumes, so root
# detection and link derivation live here only — doctor checks the links this
# script would really make, not a second guess.

self="${0##*/}"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
manifest="${SKLINK_MANIFEST:-$config_home/sklink/manifest}"

usage() {
  cat <<EOF
$self — reconcile agent skill links from the sklink manifest.

  $self [-n|--dry-run] [-v|--verbose] [-q|--quiet]
  $self --print-roots        list the detected user-wide skill roots
  $self --print-plan         list every link the manifest asks for

Reads $manifest (override with SKLINK_MANIFEST).
Safe to run from a hook, a login script or cron; -q keeps it silent.
EOF
}

mode="apply"; verbose=0; quiet=0; dry=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --print-roots) mode="roots";;
    --print-plan)  mode="plan";;
    -n|--dry-run)  dry=1;;
    -v|--verbose)  verbose=1;;
    -q|--quiet)    quiet=1;;
    -h|--help)     usage; exit 0;;
    *) printf '%s: unknown option: %s\n' "$self" "$1" >&2; usage >&2; exit 2;;
  esac
  shift
done

# stdout and stderr decided separately: `sklink sync > log` still has a terminal
# on stderr. Duplicated in the CLI on purpose — each script has to stand alone.
if [[ -t 1 && -z "${NO_COLOR:-}" && "${TERM:-}" != "dumb" ]]; then
  c_bold=$'\033[1m'; c_dim=$'\033[2m'; c_green=$'\033[32m'; c_yellow=$'\033[33m'; c_off=$'\033[0m'
else
  c_bold=""; c_dim=""; c_green=""; c_yellow=""; c_off=""
fi
if [[ -t 2 && -z "${NO_COLOR:-}" && "${TERM:-}" != "dumb" ]]; then
  e_warn=$'\033[33m'; e_err=$'\033[31m'; e_off=$'\033[0m'
else
  e_warn=""; e_err=""; e_off=""
fi

expand_tilde() { printf '%s' "${1/#\~/$HOME}"; }

# Literal prefix comparison: ${p/#$HOME/~} would expand $HOME as a glob and can
# collapse a path that merely resembles home. Display only.
collapse_home() {
  local p="$1"
  if [[ "$p" == "$HOME" ]]; then printf '~'
  elif [[ "$p" == "$HOME"/* ]]; then printf '~%s' "${p#"$HOME"}"
  else printf '%s' "$p"
  fi
}

# Silent under --print-plan: doctor reports the same conditions in its own words.
warn() {
  [[ "$mode" == "plan" ]] && return 0
  printf '%swarning:%s %s\n' "$e_warn" "$e_off" "$*" >&2
  return 0
}
say() { [[ "$quiet" == 1 ]] || printf '%s\n' "$*"; return 0; }
plural() { [[ "$1" == 1 ]] || printf 's'; return 0; }

# "<agent-home>|<skills-root>"; a root is used only if its agent home exists, so
# installing or removing an agent needs no change here.
default_candidates=(
  "$HOME/.claude|$HOME/.claude/skills"
  "$HOME/.codex|$HOME/.codex/skills"
  "$HOME/.agents|$HOME/.agents/skills"
)

user_roots=()
if [[ -n "${SKLINK_ROOTS:-}" ]]; then
  IFS=': ' read -r -a user_roots <<< "$SKLINK_ROOTS"
else
  for cand in "${default_candidates[@]}"; do
    home="${cand%%|*}"; root="${cand#*|}"
    [[ -d "$home" ]] && user_roots+=("$root")
  done
fi

# Answered before the manifest check — it needs no manifest.
if [[ "$mode" == "roots" ]]; then
  for root in ${user_roots[@]+"${user_roots[@]}"}; do printf '%s\n' "$root"; done
  exit 0
fi

if [[ ! -f "$manifest" ]]; then
  printf '%s%s:%s manifest not found: %s\n' "$e_err" "$self" "$e_off" "$manifest" >&2
  printf "%s: create one with 'sklink init', or set SKLINK_MANIFEST\\n" "$self" >&2
  exit 1
fi

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/sklink"
state_file="$state_dir/managed.tsv"

# Explicit, unlike the user roots: an agent leaves no marker in a repo it has not
# been used in yet, so there is nothing to detect.
project_subdirs=(".claude/skills" ".codex/skills")

status=0
created=""   # accumulator, one "<root>\t<name>" per link we now manage
src_missing=0
n_skills=0; n_links=0; n_new=0; n_retarget=0; n_same=0; n_pruned=0; n_unknown=0
n_user_entries=0

# Show the source only when the link changed target, or under -v.
report() {  # <marker> <colour> <link-path> <source>
  local arrow=""
  if [[ "$verbose" == 1 || "$1" == "~" ]]; then arrow=" -> $(collapse_home "$4")"; fi
  say "$(printf '  %s%s%s %s%s%s%s' "$2" "$1" "$c_off" "$c_dim" "$(collapse_home "$3")" "$arrow" "$c_off")"
}

# Source gone, nothing to relink — but keep the link under management. Dropping
# it from the state file would orphan it: doctor stops reporting it, and a later
# `sklink rm` could never prune it.
keep_managed() {
  # Explicit `return 0`, as everywhere here: a bare `return` hands back the
  # test's status, and a false one aborts the run under `set -e` — before the
  # prune and before the state file is written.
  [[ -L "$1/$2" ]] && created+="$1	$2"$'\n'
  return 0
}

link_one() {
  local root="$1" name="$2" src="$3"
  local link_path="$root/$name" current action

  if [[ -e "$link_path" && ! -L "$link_path" ]]; then
    printf '%s%s:%s refusing to replace non-symlink: %s\n' "$e_err" "$self" "$e_off" "$link_path" >&2
    status=1; return 0
  fi

  # An unreadable root makes every test below read false, so a dry run would
  # announce links that are already there. A real run finds out honestly (ln
  # fails and warns); a dry run has to say it cannot tell.
  if [[ "$dry" == 1 && -d "$root" && ! -r "$root" ]]; then
    created+="$root	$name"$'\n'
    n_links=$((n_links + 1)); n_unknown=$((n_unknown + 1))
    report "?" "$c_yellow" "$link_path" "$src"
    return 0
  fi

  # Classify before touching anything, so a converged run can say "up to date".
  if [[ -L "$link_path" ]]; then
    current="$(readlink "$link_path")"
    if [[ "$current" == "$src" ]]; then action="same"; else action="retarget"; fi
  else
    action="new"
  fi

  if [[ "$action" != "same" && "$dry" == 0 ]]; then
    # One unwritable target must not abort the reconcile: degrade to a warning
    # so the prune, the state write, and the remaining entries still happen.
    if ! mkdir -p "$root" 2>/dev/null; then
      warn "cannot create skills root: $(collapse_home "$root")"
      status=1; return 0
    fi
    # -n is what makes this repeatable: without it, ln follows an existing
    # symlink-to-a-directory and drops the new link *inside* the skill folder
    # instead of replacing the pointer.
    if ! ln -sfn "$src" "$link_path" 2>/dev/null; then
      warn "cannot link $(collapse_home "$link_path") -> $(collapse_home "$src")"
      status=1
      [[ -L "$link_path" ]] && created+="$root	$name"$'\n'
      return 0
    fi
  fi

  created+="$root	$name"$'\n'
  n_links=$((n_links + 1))
  case "$action" in
    new)      n_new=$((n_new + 1));      report "+" "$c_green" "$link_path" "$src";;
    retarget) n_retarget=$((n_retarget + 1)); report "~" "$c_yellow" "$link_path" "$src";;
    same)     n_same=$((n_same + 1)); if [[ "$verbose" == 1 ]]; then report "=" "$c_dim" "$link_path" "$src"; fi;;
  esac
  return 0
}

# Plan mode prints each target instead of creating it — same manifest walk, same
# target derivation, which is the point.
target_one() {
  if [[ "$mode" == "plan" ]]; then printf '%s/%s\t%s\n' "$1" "$2" "$3"
  elif [[ "$src_missing" == 1 ]]; then keep_managed "$1" "$2"
  else link_one "$1" "$2" "$3"
  fi
}

# --- parse manifest, create links ---
while read -r scope name src _rest || [[ -n "${scope:-}" ]]; do
  [[ -z "${scope:-}" ]] && continue
  case "$scope" in \#*) continue;; esac
  if [[ -z "${name:-}" || -z "${src:-}" ]]; then
    warn "skipping malformed manifest line near: $scope ${name:-}"
    status=1; continue
  fi
  # A space in a source path parses as source + junk, silently linking a
  # directory nobody asked for. A trailing comment is normal, so it stays quiet.
  case "${_rest:-}" in
    ""|\#*) ;;
    *) warn "ignoring extra text after the source for $name (a source path cannot contain spaces)";;
  esac
  src="$(expand_tilde "$src")"
  n_skills=$((n_skills + 1))
  # Once per skill, not per target: a missing source is one fact about the
  # manifest, not one per agent root.
  src_missing=0
  if [[ ! -d "$src" ]]; then
    warn "source not found for $name: $(collapse_home "$src")"
    status=1; src_missing=1
  fi

  if [[ "$scope" == "user" ]]; then
    n_user_entries=$((n_user_entries + 1))
    # ${a[@]+"${a[@]}"}: bash 3.2 errors on an empty array under `set -u`, and
    # "no agent installed yet" must be a no-op, not a crash.
    for root in ${user_roots[@]+"${user_roots[@]}"}; do target_one "$root" "$name" "$src"; done
  elif [[ "$scope" == project:* ]]; then
    repo="$(expand_tilde "${scope#project:}")"
    # Without this, a stale scope (repo renamed or deleted) is conjured back by
    # the mkdir -p in link_one, as a phantom repo holding only .claude/skills.
    if [[ ! -d "$repo" ]]; then
      warn "project repo not found for $name: $(collapse_home "$repo")"
      status=1; continue
    fi
    for sub in "${project_subdirs[@]}"; do target_one "$repo/$sub" "$name" "$src"; done
  else
    warn "unknown scope \"$scope\" for $name"
    status=1
  fi
done < "$manifest"

if [[ "$mode" == "plan" ]]; then exit 0; fi

# --- prune links we created previously but no longer want ---
if [[ -f "$state_file" ]]; then
  while IFS=$'\t' read -r root name; do
    [[ -z "${root:-}" || -z "${name:-}" ]] && continue
    if ! printf '%s' "$created" | grep -qxF "$root	$name"; then
      if [[ -L "$root/$name" ]]; then
        if [[ "$dry" == 0 ]]; then rm -f "$root/$name"; fi
        n_pruned=$((n_pruned + 1))
        say "$(printf '  %s-%s %s%s  pruned%s' "$c_yellow" "$c_off" "$c_dim" "$(collapse_home "$root/$name")" "$c_off")"
      fi
    fi
  done < "$state_file"
fi

# A dry run must leave no trace: writing state here would make the next real run
# believe links exist that were never created.
if [[ "$dry" == 0 ]]; then
  mkdir -p "$state_dir" 2>/dev/null || true
  printf '%s' "$created" > "$state_file" 2>/dev/null || {
    printf '%swarning:%s cannot write state file: %s\n' "$e_warn" "$e_off" "$state_file" >&2
    status=1
  }
fi

# --- summary: what the manifest holds, and what actually moved ---
changes=""
[[ "$n_new" -gt 0 ]]      && changes="${changes:+$changes, }$n_new new"
[[ "$n_retarget" -gt 0 ]] && changes="${changes:+$changes, }$n_retarget retargeted"
[[ "$n_pruned" -gt 0 ]]   && changes="${changes:+$changes, }$n_pruned pruned"

# No agent installed yet is normal on a fresh machine, not a failure — but "up to
# date" is a baffling answer to `add`, so it gets its own verdict.
no_roots=0
[[ "${#user_roots[@]}" == 0 && "$n_user_entries" -gt 0 ]] && no_roots=1

if [[ -n "$changes" ]]; then verdict="$c_green$changes$c_off"
elif [[ "$no_roots" == 1 ]]; then verdict="${c_dim}nothing to link into$c_off"
else verdict="${c_dim}up to date$c_off"
fi
[[ "$n_unknown" -gt 0 ]] && verdict="$verdict$c_dim, $n_unknown not checked$c_off"
[[ "$status" != 0 ]] && verdict="$verdict$c_dim, with warnings above$c_off"

if [[ "$n_skills" == 0 ]]; then
  say "$(printf '%sno skills registered%s  %s%s%s' \
    "$c_bold" "$c_off" "$c_dim" "$(collapse_home "$manifest")" "$c_off")"
else
  say "$(printf '%s%s skill%s, %s link%s%s  %s' \
    "$c_bold" "$n_skills" "$(plural "$n_skills")" "$n_links" "$(plural "$n_links")" "$c_off" "$verdict")"
fi
if [[ "$dry" == 1 && $((n_new + n_retarget + n_pruned)) -gt 0 ]]; then
  say "$(printf '%sdry run — nothing was changed%s' "$c_dim" "$c_off")"
fi

# Built from the same candidate list, so the advice cannot drift from it.
if [[ "$no_roots" == 1 ]]; then
  homes=""
  for cand in "${default_candidates[@]}"; do homes="${homes:+$homes, }$(collapse_home "${cand%%|*}")"; done
  say "$(printf '%sno agent directory found (%s)%s' "$c_dim" "$homes" "$c_off")"
  say "$(printf '%ssync again once one exists, or set SKLINK_ROOTS%s' "$c_dim" "$c_off")"
fi

exit "$status"
